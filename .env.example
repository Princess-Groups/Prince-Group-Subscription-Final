# Supabase Configuration
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Razorpay - Get from https://dashboard.razorpay.com/app/settings/api-keys
# Use test keys for development (rzp_test_*), live keys for production (rzp_live_*)
RAZORPAY_KEY_ID="rzp_live_YOUR_ACTUAL_KEY"
VITE_RAZORPAY_KEY_ID="rzp_live_YOUR_ACTUAL_KEY"

# NOTE: RAZORPAY_KEY_SECRET should NOT be in .env for frontend
# It's only used in backend/Supabase functions
